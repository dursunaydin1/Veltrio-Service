# Normalize line endings to LF on commit, checkout as-is on Windows
* text=auto eol=lf

# Explicitly LF for source files
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.env*      text eol=lf
*.sql       text eol=lf
.gitignore  text eol=lf

# Binary — do not touch
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.pdf       binary
*.zip       binary
